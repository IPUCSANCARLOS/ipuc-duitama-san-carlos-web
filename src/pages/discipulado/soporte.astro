---
import DiscipuladoLayout from "../../layouts/DiscipuladoLayout.astro";

const base = import.meta.env.BASE_URL;
---

<DiscipuladoLayout
title="Soporte | Sistema de Discipulado"
description="Formulario de soporte del sistema de discipulado"
>


<section
class="
min-h-screen
flex
items-center
justify-center
px-5
py-10
bg-gradient-to-br
from-blue-50
via-white
to-yellow-50
"
>


<div
class="
bg-white
rounded-3xl
shadow-xl
p-8
w-full
max-w-lg
border
border-blue-100
"
>


<img

src={`${base}images/logo-ipuc-oficial.png`}

alt="IPUC San Carlos"

class="
mx-auto
h-20
mb-5
object-contain
"

/>



<h1

class="
text-2xl
font-bold
text-[#00338D]
text-center
mb-3
"

>

Soporte de acceso

</h1>



<p

class="
text-sm
text-gray-500
text-center
mb-8
"

>

Describe el problema que tienes para ingresar al sistema.
El equipo administrativo revisará tu solicitud.

</p>





<form id="soporteForm">


<label
class="
block
text-sm
font-semibold
text-gray-700
mb-2
"
>

Nombre

</label>


<input

id="nombre"

required

class="
w-full
border
rounded-xl
p-3
mb-5
"

placeholder="Nombre completo"

/>





<label
class="
block
text-sm
font-semibold
text-gray-700
mb-2
"
>

Correo electrónico

</label>


<input

id="correo"

type="email"

required

class="
w-full
border
rounded-xl
p-3
mb-5
"

placeholder="correo@gmail.com"

/>






<label
class="
block
text-sm
font-semibold
text-gray-700
mb-2
"
>

Descripción del problema

</label>


<textarea

id="problema"

required

rows="5"

class="
w-full
border
rounded-xl
p-3
mb-5
"

placeholder="Ejemplo: No puedo ingresar con Google, aparece un error..."

></textarea>






<button

type="submit"

class="
w-full
bg-[#00338D]
text-white
py-4
rounded-full
font-semibold
hover:bg-blue-900
transition
"

>

Enviar solicitud

</button>



</form>



<p

id="mensaje"

class="
text-center
mt-5
text-sm
text-gray-500
"

></p>




<div

class="
mt-6
text-center
"

>


<a

href="https://wa.me/573136596423"

target="_blank"

rel="noopener noreferrer"

class="
text-sm
text-[#00338D]
font-semibold
"

>

También puedes contactar soporte por WhatsApp

</a>


</div>




</div>


</section>





<script>

import {
db
} from "../../lib/firebase.js";


import {
collection,
addDoc,
serverTimestamp
} from "firebase/firestore";



const formulario =
document.getElementById("soporteForm");


const mensaje =
document.getElementById("mensaje");



formulario?.addEventListener(
"submit",
async(e)=>{


e.preventDefault();



const nombre =
document.getElementById("nombre").value;


const correo =
document.getElementById("correo").value;


const problema =
document.getElementById("problema").value;



try{


// 1. Guardar en Firestore

await addDoc(

collection(
db,
"solicitudes_soporte"
),

{


nombre,

correo,

problema,


estado:
"pendiente",


fecha:
serverTimestamp()


}

);



// 2. Preparar WhatsApp


const mensajeWhatsApp =

`
Solicitud de soporte - Sistema de Discipulado

Nombre:
${nombre}

Correo:
${correo}

Problema:
${problema}

Fecha:
${new Date().toLocaleString()}
`;



const urlWhatsApp =

"https://wa.me/573136596423?text="
+
encodeURIComponent(
mensajeWhatsApp
);



mensaje.textContent =
"Solicitud enviada correctamente. Abriendo WhatsApp...";



// abrir WhatsApp

setTimeout(()=>{

window.open(
urlWhatsApp,
"_blank"
);


},800);



formulario.reset();



}


catch(error){


console.error(
"Error Firestore:",
error
);



mensaje.textContent =
"Error al enviar la solicitud.";


}



});


</script>


</DiscipuladoLayout>