"

>

<option value="lider">
Líder
</option>

<option value="pastor">
Pastor
</option>

<option value="administrador">
Administrador
</option>

<option value="auxiliar">
Auxiliar
</option>

</select>




<label>

Nivel de acceso

</label>


<select

id="nivelAccesoUsuario"

class="
w-full
border
rounded-lg
p-3
mb-4
"

>


<option value="principal">
Principal
</option>


<option value="gestion_ministerial">
Gestión ministerial
</option>


<option value="supervision_pastoral">
Supervisión pastoral
</option>


<option value="ministerial">
Ministerial
</option>


<option value="consulta_general">
Consulta general
</option>

<option value="gestion">
Gestión
</option>


</select>





