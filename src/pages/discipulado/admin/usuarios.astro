mb-5
"

>

Usuarios registrados

</h2>




<div

id="usuarios"

>

Cargando...

</div>



</div>



<!-- MODAL GESTION -->

<div

id="modalUsuario"

class="
hidden
fixed
inset-0
bg-black/40
flex
items-center
justify-center
p-5
z-50
"

>


<div

class="
bg-white
rounded-3xl
p-5
sm:p-8
w-full
max-w-md
max-h-[90vh]
overflow-y-auto
"

>


<h2

class="
text-xl
font-bold
text-[#00338D]
mb-5
"

>

Gestionar usuario

</h2>




<p

id="nombreUsuario"

class="
font-semibold
"

>

</p>




<p

id="correoUsuario"

class="
text-sm
text-gray-500
mb-5
"

>

</p>



<input

id="usuarioUid"

type="hidden"

/>

<label>

Ministerio

</label>


<select

id="ministerioUsuario"

class="
w-full
border
rounded-lg
