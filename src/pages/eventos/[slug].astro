<script define:vars={{ galleryImages, galleryThumbs }}>


const imagesGallery =
galleryImages || [];


const lightbox =
document.querySelector("#lightbox");


const lightboxImg =
document.querySelector("#lightbox-img");


const buttons =
document.querySelectorAll(".gallery-open");

const loadMoreButton =
document.querySelector("#load-more-gallery");


let visibleImages = 24;

const close =
document.querySelector("#close-lightbox");


const next =
document.querySelector("#next-image");


const prev =
document.querySelector("#prev-image");


let current = 0;



function showImage(){

if(!imagesGallery[current]){
return;
}


lightboxImg.classList.remove("loaded");


const img = new Image();


img.onload = ()=>{

lightboxImg.src =
imagesGallery[current];


lightboxImg.classList.add("loaded");

};


img.onerror = ()=>{

console.error(
"Error cargando imagen:",
imagesGallery[current]
);

};


img.src =
imagesGallery[current];

}


function openImage(index){


current=index;


showImage();


lightbox.classList.add("active");

lightbox.setAttribute(
"aria-hidden",
"false"
);

document.body.style.overflow="hidden";


}




function closeImage(){


lightbox.classList.remove("active");

lightbox.setAttribute(
"aria-hidden",
"true"
);

document.body.style.overflow="";

}




function nextImage(){


current++;


if(current >= imagesGallery.length){

current=0;

}


showImage();

}




function previousImage(){


current--;


if(current < 0){

current =
imagesGallery.length-1;

}


showImage();

}


function loadMoreImages(){


const gallery =
document.querySelector(".gallery");


const nextImages =
galleryThumbs
.slice(
visibleImages,
visibleImages + 24
);

nextImages.forEach(

(img,index)=>{


const realIndex =
visibleImages + index;



const button =
document.createElement("button");


button.type="button";


button.className =
"gallery-card gallery-open";


button.dataset.index =
realIndex;



button.innerHTML = `

<img

src="${galleryThumbs[realIndex]}"

loading="lazy"

decoding="async"

width="600"

height="450"

referrerpolicy="no-referrer"

alt="Imagen ${realIndex+1}"

/>

`;



button.addEventListener(
"click",
()=>{

openImage(realIndex);

}

);



gallery.appendChild(button);



});


visibleImages += 24;



if(
visibleImages >= galleryThumbs.length
){

loadMoreButton.style.display="none";

}


}


document.addEventListener(
"click",
(e)=>{


const button =
e.target.closest(
".gallery-open"
);


if(!button){
return;
}


openImage(
Number(button.dataset.index)
);


}
);




close?.addEventListener(
"click",
closeImage
);



next?.addEventListener(
"click",
nextImage
);



prev?.addEventListener(
"click",
previousImage
);


if(loadMoreButton){

loadMoreButton.addEventListener(
"click",
loadMoreImages
);

}


lightbox.addEventListener(
"click",
(e)=>{


if(e.target===lightbox){

closeImage();

}


});





document.addEventListener(
"keydown",
(e)=>{


if(!lightbox.classList.contains("active"))
return;


if(e.key==="Escape")
closeImage();


if(e.key==="ArrowRight")
nextImage();


if(e.key==="ArrowLeft")
previousImage();


});



</script>



