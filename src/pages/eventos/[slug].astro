---
import Layout from "../../layouts/Layout.astro";
import { getPosts } from "../../lib/blogger";


export async function getStaticPaths(){

const posts = await getPosts();


return posts.map((post)=>({

params:{
slug:post.slug
},

props:{
post
}

}));

}



const {post}=Astro.props;


if(!post){

return Astro.redirect("/eventos");

}



const rawContent = post.content || "";





/*
=========================================
 EXTRAER IMAGENES DE BLOGGER
=========================================
*/


const images = [

...rawContent.matchAll(
/<img[^>]+src=["']([^"']+)["']/gi
)

]

.map(
(item)=>item[1]
)

.filter(Boolean)

.filter(
(img,index,array)=>
array.indexOf(img)===index
)

.filter(
(img)=>img !== post.image
);








/*
=========================================
 LIMPIAR ARTICULO
=========================================
*/


function cleanArticle(html){


if(!html){

return "";

}


return html


// quitar css

.replace(
/<style[\s\S]*?<\/style>/gi,
""
)


// quitar javascript

.replace(
/<script[\s\S]*?<\/script>/gi,
""
)


// quitar comentarios

.replace(
/<!--[\s\S]*?-->/g,
""
)


// quitar visor blogger

.replace(
/🔍|×|›|‹|&nbsp;|&#10005;|&#10094;|&#10095;/g,
""
)


// quitar imagenes

.replace(
/<img[^>]*>/gi,
""
)


// quitar enlaces blogger

.replace(
/<a[^>]*>/gi,
""
)

.replace(
/<\/a>/gi,
""
)


// quitar clases blogger

.replace(
/class="[^"]*"/gi,
""
)


// quitar estilos inline

.replace(
/style="[^"]*"/gi,
""
)


// eliminar div vacios

.replace(
/<div>\s*<\/div>/gi,
""
)

.trim();


}



const content = cleanArticle(rawContent);



const shareUrl =
`${Astro.url.origin}/eventos/${post.slug}`;

---




<Layout

title={post.title}

description={post.description}

>




<main
class="
pt-28
pb-24
bg-gradient-to-b
from-gray-50
to-white
"
>


<div
class="
max-w-6xl
mx-auto
px-6
"
>



<article

class="
bg-white
rounded-[2rem]
shadow-2xl
overflow-hidden
"
>





<!-- PORTADA -->


<section
class="
relative
h-[350px]
md:h-[560px]
overflow-hidden
"
>


<img

src={
post.image ||
"/images/logo-san-carlos.png"
}

alt={post.title}

class="
w-full
h-full
object-cover
"
/>



<div
class="
absolute
inset-0
bg-gradient-to-t
from-[#00338D]
via-[#00338D]/50
to-transparent
"
></div>



<div

class="
absolute
bottom-0
left-0
p-8
md:p-14
text-white
"

>


<p

class="
uppercase
tracking-[0.3em]
text-yellow-400
font-bold
text-sm
"

>

EVENTO INSTITUCIONAL

</p>



<h1

class="
mt-5
text-3xl
md:text-5xl
font-bold
leading-tight
"

>

{post.title}

</h1>



</div>


</section>








<!-- INFORMACION -->


<section

class="
p-8
md:p-14
"

>



<div

class="
flex
flex-wrap
justify-between
items-center
gap-6
border-b
pb-8
"

>


<div>

<p class="text-gray-500">

Fecha del evento

</p>


<p

class="
text-xl
font-bold
text-[#00338D]
"

>


{
post.date

?

new Date(post.date)
.toLocaleDateString(
"es-CO",
{
year:"numeric",
month:"long",
day:"numeric"
}
)

:

"Fecha no disponible"

}


</p>

</div>





<a

href={
`https://wa.me/?text=${encodeURIComponent(
post.title+" "+shareUrl
)}`
}

target="_blank"

class="
bg-green-500
text-white
px-7
py-3
rounded-full
font-bold
shadow-lg
"

>

Compartir WhatsApp

</a>


</div>








<!-- TEXTO -->


<div

class="
article-content
mt-12
"

set:html={content}

></div>









<!-- GALERIA -->


{

images.length >0 &&


<section

class="
mt-16
"

>


<h2

class="
text-3xl
font-bold
text-[#00338D]
mb-8
"

>

Galería del evento

</h2>




<div

class="
gallery
"

>


{

images.map(
(img,index)=>(


<div

class="
gallery-card
"

>


<img

src={img}

alt={`${post.title}-${index}`}

loading="lazy"

/>


</div>


)

)

}


</div>



</section>


}









<a

href="/#eventos"

class="
inline-block
mt-16
bg-[#F0AB00]
px-8
py-4
rounded-full
font-bold
text-[#00338D]
shadow-lg
"

>

← Volver a eventos

</a>




</section>




</article>



</div>


</main>






<style>


.article-content{

font-size:1.1rem;

line-height:1.9;

color:#374151;

overflow-wrap:anywhere;

}



.article-content p{

margin-bottom:1.5rem;

}



.article-content h1,
.article-content h2,
.article-content h3{

color:#00338D;

font-weight:800;

margin-top:2rem;

margin-bottom:1rem;

}





.gallery{

display:grid;

grid-template-columns:
repeat(3,1fr);

gap:1.5rem;

}



.gallery-card{

overflow:hidden;

border-radius:1.5rem;

background:white;

box-shadow:
0 15px 35px rgba(0,0,0,.15);

}



.gallery-card img{

width:100%;

height:350px;

object-fit:cover;

display:block;

transition:.4s;

}



.gallery-card:hover img{

transform:scale(1.05);

}





@media(max-width:1024px){


.gallery{

grid-template-columns:
repeat(2,1fr);

}

}



@media(max-width:640px){


.article-content{

font-size:1rem;

line-height:1.7;

}



.gallery{

grid-template-columns:1fr;

}



.gallery-card img{

height:auto;

aspect-ratio:4/3;

}


}



</style>


</Layout>