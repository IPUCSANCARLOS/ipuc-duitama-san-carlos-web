</main>




<script define:vars={{ galleryImages }}>


const imagesGallery =
galleryImages || [];


const lightbox =
document.querySelector("#lightbox");


const lightboxImg =
document.querySelector("#lightbox-img");


const buttons =
document.querySelectorAll(".gallery-open");


const close =
document.querySelector("#close-lightbox");


const next =
document.querySelector("#next-image");


const prev =
document.querySelector("#prev-image");


let current = 0;



function showImage(){

if(!imagesGallery[current]){
return;
}


lightboxImg.src =
imagesGallery[current];


lightboxImg.alt =
`Imagen ${current+1}`;

}




function openImage(index){


current=index;


showImage();


lightbox.classList.add("active");


document.body.style.overflow="hidden";


}




function closeImage(){


lightbox.classList.remove("active");


document.body.style.overflow="";

}




function nextImage(){


current++;


if(current >= imagesGallery.length){

current=0;

}


showImage();

}




function previousImage(){


current--;


if(current < 0){

current =
imagesGallery.length-1;

}


showImage();

}





buttons.forEach(
(btn)=>{


btn.addEventListener(
"click",
()=>{

openImage(
Number(btn.dataset.index)
);


});


});




close.addEventListener(
"click",
closeImage
);



next.addEventListener(
"click",
nextImage
);



prev.addEventListener(
"click",
previousImage
);





lightbox.addEventListener(
"click",
(e)=>{


if(e.target===lightbox){

closeImage();

}


});





document.addEventListener(
"keydown",
(e)=>{


if(!lightbox.classList.contains("active"))
return;


if(e.key==="Escape")
closeImage();


if(e.key==="ArrowRight")
nextImage();


if(e.key==="ArrowLeft")
previousImage();


});



</script>





<style>


.article-content{

font-size:1.1rem;

line-height:1.9;

color:#374151;

overflow-wrap:anywhere;

}



.article-content p{

margin-bottom:1.5rem;

}



.article-content h1,
.article-content h2,
.article-content h3{

color:#00338D;

font-weight:800;

margin-top:2rem;

margin-bottom:1rem;

}







/*
==========================
 GALERÍA
==========================
*/


.gallery{

display:grid;

grid-template-columns:
repeat(3,1fr);

gap:1.5rem;

}



.gallery-card{

border:none;

padding:0;

background:white;

cursor:pointer;

border-radius:24px;

overflow:hidden;

position:relative;

box-shadow:

0 12px 35px rgba(0,51,141,.12);

transition:

transform .35s ease,
box-shadow .35s ease;


animation:

galleryShow .6s ease both;

}


.gallery-card:hover{

transform:

translateY(-8px);


box-shadow:

0 25px 50px rgba(0,51,141,.25);

}



.gallery-card img{

width:100%;

height:320px;


object-fit:cover;


background:#f8fafc;


display:block;


transition:

transform .5s ease;

}



.gallery-card:hover img{

transform:

scale(1.06);

}

.gallery-card::after{

content:"🔍";


position:absolute;


top:15px;

right:15px;


width:45px;

height:45px;


display:flex;

align-items:center;

justify-content:center;


border-radius:50%;


background:white;


box-shadow:

0 5px 15px rgba(0,0,0,.2);


opacity:0;


transform:scale(.8);


transition:.3s;

}



.gallery-card:hover::after{

opacity:1;

transform:scale(1);

}

.gallery-card:hover img{

transform:scale(1.03);

}






/* ==========================
   LIGHTBOX IPUC
========================== */


.lightbox{

position:fixed;

inset:0;

background:
rgba(0,0,0,.94);

z-index:99999;

display:flex;

align-items:center;

justify-content:center;

padding:25px;


opacity:0;

visibility:hidden;

transition:
opacity .3s ease;

backdrop-filter:
blur(6px);

}



.lightbox.active{

opacity:1;

visibility:visible;

}




#lightbox-img{

max-width:90vw;

max-height:85vh;

width:auto;

height:auto;

object-fit:contain;

border-radius:18px;

animation:

imageZoom .3s ease;

}

@keyframes imageZoom{


from{

opacity:0;

transform:

scale(.92);

}


to{

opacity:1;

transform:

scale(1);

}


}

max-height:85vh;


width:auto;

height:auto;


object-fit:contain;


border-radius:18px;


box-shadow:

0 30px 80px rgba(0,0,0,.55);


}





/* ======================
   BOTON CERRAR
====================== */


.lightbox-close{


position:absolute;


top:25px;

right:30px;


width:58px;

height:58px;


display:flex;

align-items:center;

justify-content:center;


border-radius:50%;


border:

3px solid #00338D;


background:white;


color:#00338D;


font-size:38px;


font-weight:700;


cursor:pointer;


z-index:100001;


box-shadow:

0 10px 30px rgba(0,0,0,.35);


transition:.25s;


}



.lightbox-close:hover{


background:#F0AB00;


color:white;


border-color:#F0AB00;


transform:

rotate(90deg)
scale(1.08);


}




/* ======================
   FLECHAS
====================== */


.lightbox-arrow{


position:absolute;


top:50%;


transform:

translateY(-50%);


width:65px;


height:65px;


display:flex;

align-items:center;

justify-content:center;


border-radius:50%;


border:

3px solid #F0AB00;


background:

#00338D;


color:white;


font-size:48px;


font-weight:700;


line-height:1;


cursor:pointer;


z-index:100001;


box-shadow:

0 12px 35px rgba(0,0,0,.45);


transition:.25s;


}



.lightbox-arrow:hover{


background:#F0AB00;


border-color:white;


transform:

translateY(-50%)
scale(1.12);


