---
import Layout from "../../layouts/Layout.astro";
import { getPosts } from "../../lib/blogger";

import {
extractBloggerImages
} from "../../lib/bloggerImages";


import {
extractBloggerVideos
} from "../../lib/bloggerVideos";



export async function getStaticPaths(){

const posts = await getPosts();


return posts.map((post)=>({

params:{
slug:post.slug
},

props:{
post
}

}));

}



const {post}=Astro.props;


if(!post){

return Astro.redirect(
`${import.meta.env.BASE_URL}eventos/`
);

}



const rawContent = post.content || "";





/*
=========================================
 EXTRAER IMÁGENES DE BLOGGER
=========================================
*/

let images =
extractBloggerImages(rawContent);




console.log(
"================================="
);


console.log(
"EVENTO:",
post.title
);


console.log(
"CONTENIDO RAW:",
rawContent.substring(0,1000)
);

console.log(
"TOTAL IMAGENES:",
images.length
);

const videos =
extractBloggerVideos(rawContent);


console.log(
"TOTAL VIDEOS:",
videos.length
);


console.table(videos);




console.log(
"================================="
);
/*
=========================================
 LIMPIAR ARTÍCULO
=========================================
*/


function cleanArticle(html){


if(!html){

return "";

}


return html


.replace(
/<style[\s\S]*?<\/style>/gi,
""
)


.replace(
/<script[\s\S]*?<\/script>/gi,
""
)


.replace(
/<!--[\s\S]*?-->/g,
""
)


.replace(
/🔍|×|›|‹|&nbsp;|&#10005;|&#10094;|&#10095;/g,
""
)


.replace(
/<img[^>]*>/gi,
""
)


.replace(
/<a[^>]*>/gi,
""
)


.replace(
/<\/a>/gi,
""
)


.replace(
/class="[^"]*"/gi,
""
)


.replace(
/style="[^"]*"/gi,
""
)


.replace(
/<div>\s*<\/div>/gi,
""
)


.trim();


}



const content = cleanArticle(rawContent);



const shareUrl =
`${Astro.url.origin}${import.meta.env.BASE_URL}eventos/${post.slug}/`;


console.table(images);

const galleryImages = images;

---





