---
import Layout from "../layouts/Layout.astro";


const title = 
"IPUC Kids | Juegos bíblicos y aprendizaje cristiano para niños";


const description =
"IPUC Kids es un espacio especial para niños y niñas de la Obra Misionera Duitama San Carlos, donde aprenden de Jesús mediante juegos bíblicos y actividades interactivas.";

---


<Layout
title={title}
description={description}
>


<main>



<!-- =====================================
     HERO KIDS
===================================== -->


<section

class="
relative
overflow-hidden
min-h-[650px]
flex
items-center
justify-center
bg-gradient-to-br
from-[#009FDA]
via-[#38BDF8]
to-[#00338D]
"

>


<!-- DECORACIONES -->

<div
class="
absolute
top-10
left-10
w-32
h-32
bg-white/20
rounded-full
blur-3xl
"
></div>


<div
class="
absolute
bottom-10
right-10
w-40
h-40
bg-[#F0AB00]/30
rounded-full
blur-3xl
"
></div>




<div

class="
relative
z-10
max-w-6xl
mx-auto
px-6
grid
lg:grid-cols-2
gap-12
items-center
"

>


<!-- TEXTO -->


<div
class="
text-white
text-center
lg:text-left
"
data-animate
>


<p

class="
uppercase
tracking-[5px]
font-bold
text-[#F0AB00]
mb-5
"

>

Espacio infantil IPUC

</p>



<h1

class="
text-5xl
md:text-6xl
font-extrabold
leading-tight
"

>

IPUC Kids

</h1>



<h2

class="
mt-5
text-2xl
md:text-3xl
font-semibold
"

>

Aprendiendo de Jesús,
jugando y creciendo en la fe

</h2>



<p

class="
mt-6
text-lg
text-white/90
leading-relaxed
"

>

Un lugar especial para que los niños descubran
la Palabra de Dios mediante juegos bíblicos,
actividades y experiencias interactivas.

</p>




<div

class="
mt-8
flex
flex-wrap
justify-center
lg:justify-start
gap-4
"

>


<a

href="#juegos"

class="
bg-[#F0AB00]
text-[#00338D]
font-bold
px-8
py-3
rounded-full
shadow-xl
hover:-translate-y-1
transition
"

>

🎮 Juegos bíblicos

</a>



<a

href="#biblia"

class="
bg-white/20
backdrop-blur
border
border-white/40
px-8
py-3
rounded-full
font-bold
text-white
hover:bg-white/30
transition
"

>

📖 Aprender Biblia

</a>


</div>


</div>





<!-- IMAGEN -->


<div

class="
flex
justify-center
"

data-animate
data-delay="2"

>


<img

src={`${import.meta.env.BASE_URL}images/kids/unanimes-kids.webp`}

alt="IPUC Kids niños aprendiendo de Jesús"

loading="eager"

class="
max-w-md
w-full
drop-shadow-2xl
hover:scale-105
transition
duration-500
"

>


</div>



</div>



</section>









<!-- =====================================
     JUEGOS BIBLICOS
===================================== -->


<section

id="juegos"

class="
py-20
bg-white
"

>


<div

class="
max-w-7xl
mx-auto
px-6
"

>


<div
class="
text-center
mb-14
"
>


<p

class="
text-[#F0AB00]
uppercase
font-bold
tracking-[4px]
"

>

Diviértete aprendiendo

</p>


<h2

class="
text-4xl
font-extrabold
text-[#00338D]
mt-3
"

>

Juegos bíblicos

</h2>


<p

class="
mt-4
text-gray-600
max-w-2xl
mx-auto
"

>

Explora actividades diseñadas para aprender
historias, personajes y enseñanzas de la Biblia.

</p>


</div>







<div

class="
grid
sm:grid-cols-2
lg:grid-cols-3
gap-8
"

>





<!-- TARJETA -->
{
[
{
titulo:"Quiz Bíblico",
texto:"Pon a prueba tus conocimientos de la Biblia.",
icono:"🎯",
url:"https://ipucsancarlos.github.io/quiz-biblico/",
interno:false
},

{
titulo:"¿Dónde está el versículo?",
texto:"Busca y descubre las enseñanzas bíblicas.",
icono:"📖",
url:"/kids/juegos/donde-esta-el-versiculo",
interno:true
},

{
titulo:"Parejas Bíblicas",
texto:"Encuentra personajes y elementos bíblicos.",
icono:"🧩",
url:"https://ipucsancarlos.github.io/parejas_biblicas/",
interno:false
},

{
titulo:"¿Quién soy?",
texto:"Descubre personajes de la Biblia.",
icono:"❓",
url:"https://ipucsancarlos.github.io/quien_soy/",
interno:false
},

{
titulo:"Arma el Versículo",
texto:"Ordena las palabras y completa la enseñanza.",
icono:"💎",
url:"https://ipucsancarlos.github.io/Arma-el-Vers-culo/",
interno:false
}

].map((juego)=>(


<a

href={juego.url}

target={
juego.interno
?
"_self"
:
"_blank"
}

rel="noopener noreferrer"



class="
group
rounded-3xl
bg-white
border
border-gray-100
shadow-lg
p-8
hover:-translate-y-3
hover:shadow-2xl
transition
"

>


<div

class="
text-5xl
mb-6
"

>

{juego.icono}

</div>


<h3

class="
text-xl
font-bold
text-[#00338D]
group-hover:text-[#F0AB00]
transition
"

>

{juego.titulo}

</h3>


<p

class="
mt-3
text-gray-600
"

>

{juego.texto}

</p>



<span

class="
inline-block
mt-6
font-bold
text-[#009FDA]
"

>

Jugar ahora →

</span>


</a>



))

}



</div>


</div>


</section>









<!-- =====================================
     VERSICULO
===================================== -->


<section

id="biblia"

class="
py-20
bg-[#00338D]
text-white
text-center
"

>


<div

class="
max-w-4xl
mx-auto
px-6
"

>


<h2

class="
text-3xl
md:text-4xl
font-bold
"

>

Jesús ama a los niños

</h2>


<p

class="
mt-6
text-xl
italic
"

>

"Dejad a los niños venir a mí,
y no se lo impidáis"

</p>


<p

class="
mt-3
text-[#F0AB00]
font-bold
"

>

Mateo 19:14

</p>


</div>


</section>





</main>


</Layout>