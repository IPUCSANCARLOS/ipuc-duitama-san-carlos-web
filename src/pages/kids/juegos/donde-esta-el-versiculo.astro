<style is:global>


/* =====================================================
   IPUC KIDS - JUEGO BÍBLICO
   SISTEMA VISUAL
===================================================== */



/* Tarjetas informativas inicio */


.kids-info-card {


    background:

    linear-gradient(

        145deg,

        #ffffff,

        #f4f9ff

    );


    border:

    2px solid rgba(0,51,141,.08);


    border-radius:

    1.5rem;


    padding:

    1.5rem;


    display:flex;


    flex-direction:column;


    align-items:center;


    justify-content:center;


    gap:.5rem;


    font-size:2rem;


    color:#00338D;


    box-shadow:

    0 10px 25px rgba(0,0,0,.08);


    transition:

    .35s ease;

}



.kids-info-card p {


    margin:0;


    font-size:1rem;


    font-weight:700;


    color:#334155;

}



.kids-info-card:hover {


    transform:

    translateY(-8px);


    box-shadow:

    0 18px 35px rgba(0,51,141,.18);

}





/* =====================================================
   OPCIONES DE RESPUESTA
===================================================== */


.kids-option {


    width:100%;


    min-height:75px;


    display:flex;


    align-items:center;


    gap:1rem;


    padding:1rem 1.25rem;


    background:white;


    border:

    2px solid #dbe7f5;


    border-radius:

    1.25rem;


    cursor:pointer;


    transition:

    all .3s ease;


    font-weight:700;


    color:#1f2937;


    text-align:left;


}



.kids-option:hover {


    border-color:

    #009FDA;


    transform:

    translateY(-3px);


    box-shadow:

    0 10px 25px rgba(0,159,218,.15);

}





/* Letra de respuesta */


.kids-option-letter {


    width:42px;


    height:42px;


    flex-shrink:0;


    border-radius:50%;


    display:flex;


    align-items:center;


    justify-content:center;


    background:#00338D;


    color:white;


    font-weight:800;


}





/* Estado seleccionado */


.kids-option.selected {


    border-color:

    #009FDA;


    background:

    #effaff;

}





/* Respuesta correcta */


.kids-option.correct {


    background:

    #dcfce7;


    border-color:

    #16a34a;


    color:#166534;


    animation:

    correctAnswer .45s ease;

}



.kids-option.correct
.kids-option-letter {


    background:#16a34a;

}




/* Respuesta incorrecta */


.kids-option.incorrect {


    background:

    #fee2e2;


    border-color:

    #dc2626;


    color:#991b1b;


    animation:

    wrongAnswer .45s ease;

}



.kids-option.incorrect
.kids-option-letter {


    background:#dc2626;

}





/* =====================================================
   ANIMACIONES RESPUESTAS
===================================================== */


@keyframes correctAnswer {


    0%{

        transform:scale(1);

    }


    50%{

        transform:scale(1.03);

    }


    100%{

        transform:scale(1);

    }

}



@keyframes wrongAnswer {


    0%,
    100%{

        transform:translateX(0);

    }


    25%{

        transform:translateX(-8px);

    }


    75%{

        transform:translateX(8px);

    }

}




/* =====================================================
   BARRA DE PROGRESO
===================================================== */


#barra-progreso {


    position:relative;


    overflow:hidden;

}



#barra-progreso::after {


    content:"";


    position:absolute;


    inset:0;


    background:

    linear-gradient(

        90deg,

        transparent,

        rgba(255,255,255,.45),

        transparent

    );


    animation:

    progressGlow 2s infinite;

}



@keyframes progressGlow {


    from{

        transform:translateX(-100%);

    }


    to{

        transform:translateX(100%);

    }

}




/* =====================================================
   EXPLICACIÓN BÍBLICA
===================================================== */


#explicacion-biblica {


    animation:

    aparecer .5s ease;

}



#explicacion-biblica strong {


    color:#00338D;

}



.explicacion-icon {


    font-size:2rem;

}





/* =====================================================
   REFERENCIA BÍBLICA
===================================================== */


#referencia-biblica {


    animation:

    aparecer .4s ease;

}



@keyframes aparecer {


    from{


        opacity:0;


        transform:

        translateY(15px);


    }


    to{


        opacity:1;


        transform:

        translateY(0);


    }

}





/* =====================================================
   PANTALLA FINAL
===================================================== */


#pantalla-final {


    animation:

    aparecer .6s ease;

}



#pantalla-final .trofeo {


    animation:

    flotar 2s infinite ease-in-out;

}



@keyframes flotar {


    0%,
    100%{


        transform:

        translateY(0);


    }


    50%{


        transform:

        translateY(-12px);


    }

}





