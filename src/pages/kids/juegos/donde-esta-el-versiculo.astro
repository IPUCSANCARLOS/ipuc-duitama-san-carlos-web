<script>

import { niveles } from "../../../data/kids/versiculos.js";



/* =====================================================
   ELEMENTOS DEL DOM
===================================================== */


const pantallaInicio =
document.getElementById(
"pantalla-inicio"
);


const areaJuego =
document.getElementById(
"area-juego"
);


const pantallaFinal =
document.getElementById(
"pantalla-final"
);


const btnComenzar =
document.getElementById(
"btn-comenzar"
);


const jugarNuevo =
document.getElementById(
"jugar-nuevo"
);



const nivelTexto =
document.getElementById(
"nivel"
);



const puntosTexto =
document.getElementById(
"puntos"
);



const preguntaTexto =
document.getElementById(
"pregunta"
);



const numeroPregunta =
document.getElementById(
"numero-pregunta"
);



const opcionesContainer =
document.getElementById(
"opciones"
);



const resultadoFinal =
document.getElementById(
"resultado-final"
);



const referenciaBiblica =
document.getElementById(
"referencia-biblica"
);



const explicacionBiblica =
document.getElementById(
"explicacion-biblica"
);



const barraProgreso =
document.getElementById(
"barra-progreso"
);



const textoProgreso =
document.getElementById(
"texto-progreso"
);





/* =====================================================
   ESTADO DEL JUEGO
===================================================== */


let nivel = 1;

let puntos = 0;

let preguntaActual = 0;

let preguntasJuego = [];

let respuestasCorrectas = 0;

let bloqueado = false;





/* =====================================================
   SONIDOS
===================================================== */


const sonidoCorrecto =
new Audio(
"/audio/kids/correcto.mp3"
);


const sonidoError =
new Audio(
"/audio/kids/error.mp3"
);



function reproducirSonido(audio){

    if(!audio) return;

    audio.currentTime = 0;

    audio.play()
    .catch(()=>{});

}





/* =====================================================
   MEZCLA SEGURA
===================================================== */


function mezclar(array){


    const nuevo =
    [...array];


    for(
        let i = nuevo.length - 1;
        i > 0;
        i--
    ){

        const j =
        Math.floor(
            Math.random() *
            (i + 1)
        );


        [
            nuevo[i],
            nuevo[j]

        ] = [

            nuevo[j],
            nuevo[i]

        ];

    }


    return nuevo;

}





/* =====================================================
   INICIAR JUEGO
===================================================== */


function iniciarJuego(){


    nivel = 1;

    puntos = 0;

    preguntaActual = 0;

    respuestasCorrectas = 0;


    actualizarMarcadores();



    cargarNivel();



    pantallaInicio.classList.add(
        "hidden"
    );


    pantallaFinal.classList.add(
        "hidden"
    );


areaJuego.classList.remove(
    "hidden"
);



}





/* =====================================================
   CARGAR NIVEL
===================================================== */


function cargarNivel(){


    const preguntasNivel =
    niveles[nivel];


    if(
        !preguntasNivel ||
        preguntasNivel.length === 0
    ){

        finalizarJuego();

        return;

    }



    preguntasJuego =
    mezclar(
        preguntasNivel
    );


    preguntaActual = 0;


    nivelTexto.textContent =
    nivel;



    mostrarPregunta();

}





/* =====================================================
   MOSTRAR PREGUNTA
===================================================== */


function mostrarPregunta(){



    bloqueado = false;



    const pregunta =
    preguntasJuego[preguntaActual];



    if(!pregunta){

        finalizarJuego();

        return;

    }




    numeroPregunta.textContent =

    `${preguntaActual + 1}/${preguntasJuego.length}`;



    preguntaTexto.textContent =
    pregunta.pregunta;



    actualizarProgreso();




    /* REFERENCIA */

    if(
        pregunta.referencia
    ){

        referenciaBiblica.textContent =
        `📖 ${pregunta.referencia}`;


        referenciaBiblica.classList.remove(
            "hidden"
        );

    }

    else{


        referenciaBiblica.classList.add(
            "hidden"
        );


    }





    explicacionBiblica.classList.add(
        "hidden"
    );




    opcionesContainer.innerHTML = "";




    const respuestas =
    mezclar(
        pregunta.respuestas
    );



    respuestas.forEach(
    (respuesta,index)=>{


        const boton =
        document.createElement(
            "button"
        );



        boton.className =
        "kids-option";



        boton.innerHTML = `

        <span class="kids-option-letter">

        ${String.fromCharCode(65 + index)}

        </span>


        <span>

        ${respuesta}

        </span>

        `;



        boton.addEventListener(
            "click",
            ()=>seleccionarRespuesta(
                boton,
                respuesta,
                pregunta
            )
        );



        opcionesContainer.appendChild(
            boton
        );


    });


}







/* =====================================================
   RESPUESTA
===================================================== */


function seleccionarRespuesta(
boton,
respuesta,
pregunta
){



    if(bloqueado)
    return;



    bloqueado = true;



    const botones =
    document.querySelectorAll(
        ".kids-option"
    );



    botones.forEach(
    b=>{

        b.disabled = true;

    });



    if(
        respuesta === pregunta.correcta
    ){



        boton.classList.add(
            "correct"
        );



        puntos += 10;


        respuestasCorrectas++;


        reproducirSonido(
            sonidoCorrecto
        );



        mostrarExplicacion(
            pregunta,
            true
        );


    }

    else{


        boton.classList.add(
            "incorrect"
        );


        puntos = Math.max(
            0,
            puntos - 2
        );


        reproducirSonido(
            sonidoError
        );



        botones.forEach(
        b=>{


            if(
                b.textContent.includes(
                    pregunta.correcta
                )
            ){

                b.classList.add(
                    "correct"
                );

            }


        });



        mostrarExplicacion(
            pregunta,
            false
        );


    }



    actualizarMarcadores();

}





/* =====================================================
   EXPLICACIÓN
===================================================== */


function mostrarExplicacion(
pregunta,
correcta
){


    explicacionBiblica.innerHTML = `

    <div class="font-bold text-xl mb-2">

    ${
    correcta
    ?
    "🎉 ¡Muy bien!"
    :
    "📖 Sigue aprendiendo"
    }

    </div>


    <p>

    La respuesta correcta es:

    <strong>

    ${pregunta.correcta}

    </strong>

    </p>


    ${
    pregunta.explicacion
    ?
    `<p class="mt-3">

    ${pregunta.explicacion}

    </p>`
    :
    ""
    }

    `;



    explicacionBiblica.classList.remove(
        "hidden"
    );



    setTimeout(()=>{


        siguientePregunta();


    },3500);



}





/* =====================================================
   SIGUIENTE PREGUNTA
===================================================== */


function siguientePregunta(){


    preguntaActual++;



    if(
        preguntaActual >=
        preguntasJuego.length
    ){


        completarNivel();


        return;

    }



    mostrarPregunta();


}






/* =====================================================
   NIVEL COMPLETADO
===================================================== */


function completarNivel(){



    nivel++;



    if(
        !niveles[nivel]
    ){

        finalizarJuego();

        return;

    }



    puntos += 50;


    cargarNivel();



}





/* =====================================================
   PROGRESO
===================================================== */


function actualizarProgreso(){



    const porcentaje =

    (
        preguntaActual /
        preguntasJuego.length
    ) * 100;



    barraProgreso.style.width =

    `${porcentaje}%`;



    textoProgreso.textContent =

    `${Math.round(porcentaje)}%`;

}





/* =====================================================
   MARCADORES
===================================================== */


function actualizarMarcadores(){


    puntosTexto.textContent =
    puntos;


}







/* =====================================================
   FINAL
===================================================== */


function finalizarJuego(){



    areaJuego.classList.add(
        "hidden"
    );


    pantallaFinal.classList.remove(
        "hidden"
    );



    const mejor =
    Number(
        localStorage.getItem(
            "mejorPuntajeBiblia"
        )
        || 0
    );



    if(
        puntos > mejor
    ){

        localStorage.setItem(

            "mejorPuntajeBiblia",

            puntos

        );

    }




    resultadoFinal.innerHTML = `

    Obtuviste:

    <strong>
    ${puntos}
    puntos
    </strong>

    <br><br>

    Respuestas correctas:

    <strong>
    ${respuestasCorrectas}
    </strong>

    `;



}






/* =====================================================
   EVENTOS
===================================================== */


btnComenzar?.addEventListener(
"click",
iniciarJuego
);



jugarNuevo?.addEventListener(
"click",
()=>{


    pantallaFinal.classList.add(
        "hidden"
    );


    iniciarJuego();


}

);




</script>