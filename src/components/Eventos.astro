---
import { getPosts } from "../lib/blogger";


let posts = [];

try {

posts = await getPosts();

} catch(error){

console.error(
"Error cargando eventos:",
error
);

}


const featuredPost = posts[0];

const secondaryPosts = posts.slice(1,7);

---


<section

id="eventos"

class="
relative
py-24
bg-gradient-to-b
from-gray-50
to-white
overflow-hidden
"

>



<!-- DECORACIONES -->

<div
class="
absolute
top-0
right-0
w-96
h-96
bg-[#009FDA]/10
rounded-full
blur-3xl
"
></div>


<div
class="
absolute
bottom-0
left-0
w-72
h-72
bg-[#F0AB00]/10
rounded-full
blur-3xl
"
></div>





<div

class="
relative
z-10
max-w-7xl
mx-auto
px-6
"

>



<!-- TITULO -->

<div

data-animate

class="
text-center
max-w-3xl
mx-auto
mb-16
"

>


<p
class="
uppercase
tracking-[0.25em]
text-yellow-600
font-semibold
text-sm
"
>

Actualidad congregacional

</p>



<h2

class="
mt-4
text-4xl
md:text-5xl
font-bold
text-blue-950
"
>

Eventos y Actividades

</h2>



<p

class="
mt-6
text-gray-600
text-lg
leading-relaxed
"

>

Conoce las actividades, campañas,
programas y noticias de nuestra Obra Misionera.

</p>


</div>





<!-- EVENTO DESTACADO -->


{
featuredPost && (

<article

data-animate

class="
group
relative
overflow-hidden
rounded-[2.5rem]
shadow-2xl
mb-12
"

>


<img

src={featuredPost.image}

alt={featuredPost.title}

class="
w-full
h-[420px]
md:h-[600px]
object-cover
transition
duration-700
group-hover:scale-105
"

/>



<div

class="
absolute
inset-0
bg-gradient-to-t
from-[#00338D]
via-[#00338D]/40
to-transparent
"

></div>




<div

class="
absolute
bottom-0
left-0
p-8
md:p-14
text-white
max-w-4xl
"

>


<p

class="
uppercase
tracking-[0.3em]
text-yellow-400
font-bold
text-sm
"

>

Evento destacado

</p>




<h3

class="
mt-4
text-3xl
md:text-5xl
font-bold
"

>

{featuredPost.title}

</h3>




<p

class="
mt-5
text-gray-200
text-lg
line-clamp-3
"

>

{featuredPost.description}

</p>




<a

href={`/eventos/${featuredPost.slug}`}

class="
inline-flex
mt-8
bg-yellow-400
text-blue-950
px-8
py-4
rounded-full
font-bold
hover:bg-yellow-300
transition
"

>

Leer evento →

</a>



</div>



</article>

)
}





<!-- TARJETAS -->



{
secondaryPosts.length > 0 && (

<div

class="
grid
md:grid-cols-2
lg:grid-cols-3
gap-8
"

>


{

secondaryPosts.map(
(post,index)=>(


<article

data-animate

data-delay={(index % 3)+1}

class="
group
bg-white
rounded-[2rem]
overflow-hidden
shadow-xl
transition-all
duration-500
hover:-translate-y-3
hover:shadow-2xl
"

>


<div
class="
overflow-hidden
relative
"
>


<img

src={post.image}

alt={post.title}

loading="lazy"

class="
w-full
h-64
object-cover
transition
duration-700
group-hover:scale-110
"

/>


</div>




<div

class="
p-7
"

>


<p

class="
text-yellow-600
font-semibold
text-sm
"

>

{
post.date
?
new Date(post.date)
.toLocaleDateString("es-CO")
:
"Fecha no disponible"
}

</p>




<h3

class="
mt-3
text-xl
font-bold
text-blue-950
line-clamp-2
"

>

{post.title}

</h3>




<p

class="
mt-4
text-gray-600
line-clamp-3
"

>

{
post.description ||
"Conoce todos los detalles de esta actividad."
}

</p>




<a

href={`/eventos/${post.slug}`}

class="
inline-flex
mt-6
font-bold
text-blue-700
hover:text-yellow-600
"

>

Leer más →

</a>




</div>




</article>


)

)

}


</div>

)

}





<!-- BOTON -->

<div

class="
text-center
mt-16
"

>


<a

href="/eventos"

class="
inline-flex
bg-[#F0AB00]
text-[#00338D]
px-10
py-4
rounded-full
font-bold
shadow-xl
hover:bg-yellow-300
transition
"

>

Ver todos los eventos

</a>


</div>



</div>



</section>