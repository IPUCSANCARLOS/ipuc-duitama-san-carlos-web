<!-- =========================================
     SCRIPT RADIO PLAYER
========================================= -->


<script>

document.addEventListener(
"DOMContentLoaded",
()=>{


const audio =
document.querySelector("#radioAudio");


if(!audio){

return;

}




/*
====================================
ELEMENTOS PRINCIPALES
====================================
*/


const playButton =
document.querySelector("#playButton");


const playIcon =
document.querySelector("#playIcon");


const volumeControl =
document.querySelector("#volumeControl");


const radioMessage =
document.querySelector("#radioMessage");


const liveStatus =
document.querySelector("#liveStatus");


const waves =
document.querySelector("#waves");





/*
====================================
MODAL
====================================
*/


const modal =
document.querySelector("#radioWelcomeModal");


const modalActivate =
document.querySelector("#modalActivateRadio");


const closeRadioModal =
document.querySelector("#closeRadioModal");






/*
====================================
FLOTANTE
====================================
*/


const floatingRadio =
document.querySelector("#floatingRadio");


const floatingButton =
document.querySelector("#floatingButton");


const floatingPanel =
document.querySelector("#floatingPanel");


const floatingPlay =
document.querySelector("#floatingPlay");


const floatingIcon =
document.querySelector("#floatingIcon");


const floatingVolume =
document.querySelector("#floatingVolume");


const floatingStatus =
document.querySelector("#floatingStatus");


const closeFloating =
document.querySelector("#closeFloating");







let playing=false;









/*
====================================
ICONOS
====================================
*/


const playSVG = `

<svg
xmlns="http://www.w3.org/2000/svg"
viewBox="0 0 24 24"
fill="currentColor"
class="w-8 h-8"
>

<path d="M8 5v14l11-7z"/>

</svg>

`;




const pauseSVG = `

<svg
xmlns="http://www.w3.org/2000/svg"
viewBox="0 0 24 24"
fill="currentColor"
class="w-8 h-8"
>

<path d="M6 5h4v14H6zM14 5h4v14h-4z"/>

</svg>

`;









/*
====================================
VOLUMEN INICIAL
====================================
*/


const savedVolume =
localStorage.getItem(
"radioVolume"
);



audio.volume =
savedVolume
?
Number(savedVolume)
:
0.8;



if(volumeControl){

volumeControl.value =
audio.volume;

}



if(floatingVolume){

floatingVolume.value =
audio.volume;

}









/*
====================================
ACTUALIZAR INTERFAZ
====================================
*/


function updatePlayer(){


if(playing){



if(playIcon){

playIcon.innerHTML =
pauseSVG;

}



if(floatingIcon){

floatingIcon.innerHTML =
pauseSVG;

}



if(floatingPlay){

floatingPlay.innerHTML =
pauseSVG;

}




radioMessage.textContent =
"Transmitiendo en vivo";



floatingStatus.textContent =
"Transmitiendo en vivo";



liveStatus.textContent =
"EN VIVO";



waves?.classList.add(
"playing"
);




}

else{



if(playIcon){

playIcon.innerHTML =
playSVG;

}



if(floatingIcon){

floatingIcon.innerHTML =
playSVG;

}



if(floatingPlay){

floatingPlay.innerHTML =
playSVG;

}



radioMessage.textContent =
"Radio pausada";



floatingStatus.textContent =
"Radio pausada";



waves?.classList.remove(
"playing"
);



}



}









/*
====================================
REPRODUCIR
====================================
*/


async function playRadio(){


try{


await audio.play();


playing=true;


updatePlayer();


closeModal();


localStorage.setItem(
"radioActivo",
"true"
);



}

catch(error){


console.warn(
"El navegador bloqueó reproducción",
error
);



radioMessage.textContent =
"Presiona activar radio";



}



}









/*
====================================
PAUSAR
====================================
*/


function pauseRadio(){


audio.pause();


playing=false;


updatePlayer();



localStorage.setItem(
"radioActivo",
"false"
);



}









/*
====================================
BOTONES
====================================
*/


playButton?.addEventListener(
"click",
()=>{


playing
?
pauseRadio()
:
playRadio();


});








modalActivate?.addEventListener(
"click",
playRadio
);







closeRadioModal?.addEventListener(
"click",
closeModal
);




/*
====================================
CONTROL FLOTANTE PREMIUM
====================================
*/


let floatingTimer;



const isMobile =
window.innerWidth < 768;



function closeFloatingPanel(){

floatingPanel?.classList.add(
"hidden"
);

}



function resetFloatingTimer(){


clearTimeout(
floatingTimer
);



const delay =
isMobile
?
5000
:
15000;



floatingTimer =
setTimeout(()=>{


closeFloatingPanel();


},delay);



}






floatingButton?.addEventListener(
"click",
()=>{


const opened =
!floatingPanel.classList.contains(
"hidden"
);



floatingPanel.classList.toggle(
"hidden"
);



clearTimeout(
floatingTimer
);



if(!opened){


resetFloatingTimer();


}



});







/*
====================================
MANTENER ABIERTO CON INTERACCIÓN
====================================
*/


floatingPanel?.addEventListener(
"mouseenter",
()=>{


clearTimeout(
floatingTimer
);


});






floatingPanel?.addEventListener(
"mouseleave",
()=>{


resetFloatingTimer();


});







/*
====================================
TOQUES Y CAMBIOS DE VOLUMEN
====================================
*/


floatingPanel?.addEventListener(
"click",
()=>{


resetFloatingTimer();


});





floatingVolume?.addEventListener(
"input",
()=>{


resetFloatingTimer();


});







closeFloating?.addEventListener(
"click",
()=>{


clearTimeout(
floatingTimer
);


closeFloatingPanel();


});



floatingPlay?.addEventListener(
"click",
()=>{


playing
?
pauseRadio()
:
playRadio();


});







closeFloating?.addEventListener(
"click",
()=>{


floatingPanel.classList.add(
"hidden"
);


});









/*
====================================
VOLUMEN
====================================
*/


volumeControl?.addEventListener(
"input",
(e)=>{


audio.volume =
Number(
e.target.value
);



localStorage.setItem(
"radioVolume",
audio.volume
);



if(floatingVolume){

floatingVolume.value =
audio.volume;

}


});








floatingVolume?.addEventListener(
"input",
(e)=>{


audio.volume =
Number(
e.target.value
);



localStorage.setItem(
"radioVolume",
audio.volume
);



if(volumeControl){

volumeControl.value =
audio.volume;

}



});









/*
====================================
OCULTAR FLOTANTE EN SECCIÓN RADIO
====================================
*/


const radioSection =
document.querySelector("#radio");



if(radioSection){


const observer =
new IntersectionObserver(

(entries)=>{


entries.forEach(
(entry)=>{


if(entry.isIntersecting){


floatingRadio.classList.add(
"opacity-0",
"pointer-events-none"
);



}

else{


floatingRadio.classList.remove(
"opacity-0",
"pointer-events-none"
);



}



});


},

{
threshold:.35
}


);



observer.observe(
radioSection
);



}








/*
====================================
CERRAR MODAL
====================================
*/


function closeModal(){


if(!modal){

return;

}



modal.classList.add(
"opacity-0",
"pointer-events-none"
);



setTimeout(
()=>{


modal.classList.add(
"hidden"
);



},
400
);



}







/*
====================================
RECUPERAR ESTADO
====================================
*/


if(
localStorage.getItem(
"radioActivo"
)
==="true"
){


radioMessage.textContent =
"Radio lista para reproducir";


}





});

</script>







<style>


/*
====================================
ANIMACIÓN VISUAL AUDIO
====================================
*/


.audio-bar{


width:6px;

height:30px;

border-radius:999px;

background:#F0AB00;

opacity:.35;

transition:.3s;


}



#waves.playing .audio-bar{


animation:

audioWave

1s

ease-in-out

infinite;

opacity:1;


}





.audio-bar:nth-child(2){

animation-delay:.1s;

}


.audio-bar:nth-child(3){

animation-delay:.2s;

}


.audio-bar:nth-child(4){

animation-delay:.3s;

}


.audio-bar:nth-child(5){

animation-delay:.4s;

}


.audio-bar:nth-child(6){

animation-delay:.5s;

}


.audio-bar:nth-child(7){

animation-delay:.6s;

}


.audio-bar:nth-child(8){

animation-delay:.7s;

}


.audio-bar:nth-child(9){

animation-delay:.8s;

}







@keyframes audioWave{


0%,
100%{

height:25px;

}


50%{

height:85px;

}


}








@media(
prefers-reduced-motion:reduce
