focus:ring-[#009FDA]
outline-none
"
/>

</div>





<div>

<label
class="
block
mb-1
font-semibold
text-[#00338D]
text-sm
"
>
Número de contacto
</label>


<input
id="phone"
type="tel"
required
maxlength="10"
inputmode="numeric"
placeholder="3123456789"
class="
w-full
border
border-gray-300
rounded-xl
px-4
py-3
text-sm
focus:ring-2
focus:ring-[#009FDA]
outline-none
"
/>

</div>





<div>

<label
class="
block
mb-1
font-semibold
