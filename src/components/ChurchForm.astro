class="
fixed
inset-0
z-[999]
hidden
items-center
justify-center
bg-black/70
p-3
sm:p-6
"
>


<div
class="
relative
w-full
max-w-lg
max-h-[90vh]
bg-white
rounded-3xl
shadow-2xl
overflow-hidden
flex
flex-col
"
>


<!-- HEADER -->

<div
class="
relative
px-5
pt-6
pb-4
sm:px-8
"
>


<button
id="close-church-modal"
type="button"
aria-label="Cerrar formulario"
class="
absolute
right-4
top-4
w-9
h-9
rounded-full
bg-gray-100
text-gray-500
flex
items-center
justify-center
text-xl
hover:bg-[#00338D]
hover:text-white
transition
"
>
×
</button>


<p
class="
uppercase
tracking-[3px]
text-[#F0AB00]
font-bold
text-[11px]
"
>
Queremos conocerte
</p>



<h2
id="church-title"
class="
mt-3
pr-10
text-xl
sm:text-3xl
font-bold
text-[#00338D]
leading-tight
"
>
Haz parte de nuestra iglesia
</h2>



<p
class="
mt-2
text-sm
sm:text-base
text-gray-600
"
>
Déjanos tus datos y nos comunicaremos contigo.
</p>


</div>





<!-- CONTENIDO SCROLL -->

<div
class="
px-5
sm:px-8
overflow-y-auto
"
>


