rounded-xl
px-4
py-3
text-sm
focus:ring-2
focus:ring-[#009FDA]
outline-none
"
></textarea>

</div>



<p
class="
text-xs
text-gray-500
leading-relaxed
"
>
Al enviar este formulario autorizas el uso de tus datos únicamente para recibir información institucional de la Obra Misionera Duitama San Carlos.
</p>



</form>


</div>





<!-- BOTON FIJO -->

<div
class="
px-5
pb-5
pt-4
sm:px-8
"
>


<button
form="church-form"
type="submit"
class="
w-full
rounded-full
bg-[#00338D]
text-white
font-bold
py-3
hover:bg-blue-900
transition
"
>
Enviar por WhatsApp
</button>


</div>



</div>


</div>



<style>

@keyframes slideUp {

from {
transform:translateY(40px);
opacity:0;
}


to {
transform:translateY(0);
opacity:1;
}

}

</style>







<script>

const modal =
document.querySelector("#church-modal");


const closeButton =
document.querySelector("#close-church-modal");


const form =
document.querySelector("#church-form");




function openModal(){

modal?.classList.remove("hidden");

modal?.classList.add("flex");

document.body.classList.add("overflow-hidden");

}




function closeModal(){

modal?.classList.add("hidden");

modal?.classList.remove("flex");

document.body.classList.remove("overflow-hidden");

}




window.addEventListener(
"open-church-form",
openModal
);





closeButton?.addEventListener(
"click",
closeModal
);





modal?.addEventListener(
"click",
(e)=>{

if(e.target === modal){

closeModal();

}

}

);






document.addEventListener(
"keydown",
(e)=>{

if(e.key==="Escape"){

closeModal();

}

}

);








form?.addEventListener(
"submit",
(e)=>{


e.preventDefault();




const bot =
document.querySelector("#website")?.value;


if(bot){

return;

}





const name =
document.querySelector("#name")
.value
.trim();




const phone =
document.querySelector("#phone")
.value
.replace(/\D/g,"");




const message =
document.querySelector("#message")
.value
.trim();






if(name.length < 3){

alert("Ingrese un nombre válido.");

return;

}




if(!/^[0-9]{10}$/.test(phone)){


alert(
"Ingrese un celular colombiano válido de 10 dígitos."
);


return;

}





const cleanMessage =
message.substring(0,500);






const whatsappText =

`Hola, quiero recibir información de la Obra Misionera Duitama San Carlos.

Nombre:
${name}

Contacto:
${phone}

Mensaje:
${cleanMessage || "Sin mensaje adicional"}`;






const url =

"https://wa.me/573134096648?text="

+

encodeURIComponent(
whatsappText
);





window.open(
url,
"_blank",
"noopener,noreferrer"
);



form.reset();

closeModal();


}

);



</script>