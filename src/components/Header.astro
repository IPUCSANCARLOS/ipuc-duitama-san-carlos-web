</header>







<style>


/* ============================
   ENLACES MENU
============================ */


.menu-link,
.mobile-link{


position:relative;

transition:
color .3s ease;


}



.menu-link:hover,
.mobile-link:hover{


color:#F0AB00;


}





.menu-link::after{


content:"";

position:absolute;

left:0;

bottom:-8px;

width:0;

height:3px;

background:#F0AB00;

border-radius:20px;

transition:
width .3s ease;


}





.menu-link:hover::after{


width:100%;


}





/* ============================
   HEADER SCROLL
============================ */


#main-header{


transition:

background .4s ease,

box-shadow .4s ease,

padding .4s ease;


}



#main-header.scrolled{

background:

rgba(255,255,255,.96);

backdrop-filter:

blur(18px);

box-shadow:

0 12px 35px rgba(0,51,141,.15);

}






/* ============================
   REDUCCION DE MOVIMIENTO
============================ */


@media(
prefers-reduced-motion: reduce
){


#main-header,
.menu-link,
.mobile-link,
img{

transition:none !important;

}


}



</style>







<script>


const header =
document.querySelector("#main-header");



window.addEventListener(
"scroll",
()=>{


if(
window.scrollY > 40
){

header?.classList.add(
"scrolled"
);


}else{


header?.classList.remove(
"scrolled"
);


}


});







const menuButton =
document.querySelector("#mobile-menu-button");


const mobileMenu =
document.querySelector("#mobile-menu");


const menuIcon =
document.querySelector("#menu-icon");





function closeMenu(){


mobileMenu?.classList.add(
"hidden"
);


document.body.classList.remove(
"overflow-hidden"
);


menuIcon.textContent="☰";


menuButton?.setAttribute(
"aria-expanded",
"false"
);


}







function toggleMenu(){


const opened =
!mobileMenu?.classList.contains(
"hidden"
);



mobileMenu?.classList.toggle(
"hidden"
);



document.body.classList.toggle(
"overflow-hidden",
!opened
);



menuButton?.setAttribute(
"aria-expanded",
String(!opened)
);




menuIcon.textContent =
!opened
?
"✕"
:
"☰";


}






menuButton?.addEventListener(
"click",
toggleMenu
);








document
.querySelectorAll(".mobile-link")
.forEach(
(link)=>{


link.addEventListener(
"click",
closeMenu
);


});








function openChurchForm(){


window.dispatchEvent(
new Event(
"open-church-form"
)
);


}






document
.querySelector("#open-form-desktop")
?.addEventListener(
"click",
openChurchForm
);







document
.querySelector("#open-form-mobile")
?.addEventListener(
"click",
()=>{


openChurchForm();

closeMenu();


});



</script>