---
import "../styles/global.css";


const {
title = "Sistema de Discipulado | IPUC San Carlos",
description = "Plataforma interna de seguimiento pastoral y discipulado"
} = Astro.props;


const base = import.meta.env.BASE_URL;

---


<!doctype html>

<html lang="es">


<head>


<meta charset="UTF-8" />


<meta
name="viewport"
content="width=device-width, initial-scale=1.0"
/>


<title>
{title}
</title>



<meta
name="description"
content={description}
/>



<meta
name="theme-color"
content="#00338D"
/>



<link
rel="icon"
href={`${base}favicon.png`}
/>


</head>





<body
class="
min-h-screen
bg-gradient-to-br
from-blue-50
via-white
to-yellow-50
text-gray-800
flex
flex-col
"
>




<!-- HEADER INTERNO -->

<header

class="
bg-white/90
backdrop-blur
border-b
border-blue-100
shadow-sm
"

>


<div

class="
max-w-6xl
mx-auto
px-5
py-4
flex
items-center
justify-between
"

>


<div

class="
flex
items-center
gap-3
"

>


<img

src={`${base}images/logo-ipuc-oficial.png`}

alt="IPUC Colombia"

class="
h-12
w-12
object-contain
"

/>



<div>


<p

class="
font-bold
text-[#00338D]
text-sm
"

>

IPUC San Carlos

</p>


<p

class="
text-xs
text-gray-500
"

>

Sistema de Discipulado

</p>



</div>


</div>




<div

class="
hidden
sm:block
text-right
"

>


<p

class="
text-xs
text-gray-400
"

>

Acceso privado

</p>


<p

class="
text-xs
font-semibold
text-[#00338D]
"

>

Líderes y equipo pastoral

</p>



</div>


</div>


</header>







<main

class="
flex-1
"

>

<slot />

</main>







<footer

class="
py-6
text-center
text-xs
text-gray-400
"

>


© IPUC San Carlos · Sistema de Discipulado


</footer>






</body>


</html>